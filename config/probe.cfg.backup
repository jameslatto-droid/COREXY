#####################################################################
# Probe, Bed Mesh, and Leveling
#####################################################################

[safe_z_home]
home_xy_position: 150,150
speed: 100
z_hop: 5
z_hop_speed: 4

[bltouch]
sensor_pin: ^PA2
control_pin: PA1
stow_on_each_sample: true
samples: 2
speed: 5
lift_speed: 10
pin_move_time: 0.4
sample_retract_dist: 5
samples_tolerance: 0.0075
samples_tolerance_retries: 3
y_offset: -20
x_offset: -27

[bed_mesh]
speed: 150
horizontal_move_z: 10
mesh_min: 35,35
mesh_max: 270,270
probe_count: 7,7
fade_start: 0.5
fade_end: 5.0
mesh_pps: 2,2
algorithm: bicubic
bicubic_tension: 0.2
zero_reference_position: 150,150

[bed_screws]
screw1: 30,30
screw2: 270,30
screw3: 270,270
screw4: 30,270

[screws_tilt_adjust]
screw1: 57,50
screw1_name: front left screw
screw2: 297,50
screw2_name: front right screw
screw3: 297,290
screw3_name: rear right screw
screw4: 57,290
screw4_name: rear left screw
horizontal_move_z: 10
speed: 100
screw_thread: CW-M3

#####################################################################
# Z-Tilt Adjustment (Automatic Gantry Leveling)
#####################################################################

[z_tilt]
# Z motor positions (physical locations of Z steppers)
# Assumes CoreXY with Z motors at back left and back right
z_positions:
    30,300      # Left Z motor position (stepper_z)
    270,300     # Right Z motor position (stepper_z1)

# Probe points for leveling (must be reachable by probe)
# BLTouch offset: x=-27, y=-20
# Probe these points to measure tilt
points:
    57,280      # Left side probe point (accounting for offset)
    270,280     # Right side probe point (accounting for offset)

speed: 100
horizontal_move_z: 10
retries: 5
retry_tolerance: 0.01
