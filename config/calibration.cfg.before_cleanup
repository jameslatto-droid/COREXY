    {action_respond_info("Run FULL_CALIBRATION every:")}
    {action_respond_info("  - After moving the printer")}
    {action_respond_info("  - After adjusting bed screws")}
    {action_respond_info("  - After replacing nozzle")}
    {action_respond_info("  - Monthly for best accuracy")}
    {action_respond_info("")}
