#####################################################################
# ADVANCED CALIBRATION TOOLS
#####################################################################

[gcode_macro CAL_BED_MESH_ONLY]
description: 🗺️ Create bed mesh only (no Z-tilt)
gcode:
    {% set BED_TEMP = params.BED_TEMP|default(50)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(100)|float %}
    
    {action_respond_info("Creating bed mesh at %dC bed, %dC extruder..." % (BED_TEMP, EXTRUDER_TEMP))}
    SET_LED_EFFECT EFFECT=LED_Probing REPLACE=1
    
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}
    
    M140 S{BED_TEMP}
    M104 S{EXTRUDER_TEMP}
    M190 S{BED_TEMP}
    M109 S{EXTRUDER_TEMP}
    G4 P60000  # 1 minute stabilization
    
    BED_MESH_CALIBRATE
    {action_respond_info("Bed mesh complete!")}
    SET_LED_EFFECT EFFECT=panel_idle REPLACE=1

[gcode_macro CAL_Z_TILT_ONLY]
description: ⚖️ Level Z gantry only (no mesh)
gcode:
    {action_respond_info("Leveling dual Z gantry...")}
    SET_LED_EFFECT EFFECT=LED_Probing REPLACE=1
    
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}
    
    Z_TILT_ADJUST
    G28 Z
    {action_respond_info("Z gantry leveled!")}
    SET_LED_EFFECT EFFECT=panel_idle REPLACE=1
