    {action_respond_info("  - Weekly if printing regularly")}
    {action_respond_info("")}
    {action_respond_info("Current Z offset: %.3f mm" % printer.configfile.settings.bltouch.z_offset)}
    {action_respond_info("")}
    {action_respond_info("Default calibration temps: Bed 50C, Extruder 100C")}

