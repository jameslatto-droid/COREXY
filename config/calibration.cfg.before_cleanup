#####################################################################
# Periodic Calibration Macros
# Default temps: Bed 50C, Extruder 100C (typical calibration temps)
#####################################################################

[gcode_macro FULL_CALIBRATION]
description: Complete calibration routine - Z-tilt, bed mesh, and probe offset check
gcode:
    {% set BED_TEMP = params.BED_TEMP|default(50)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(100)|float %}
    
    M117 Starting Full Calibration
    {action_respond_info("Full Calibration Started - This will take ~10 minutes")}
    {action_respond_info("Bed: %dC, Extruder: %dC" % (BED_TEMP, EXTRUDER_TEMP))}
    SET_LED_EFFECT EFFECT=LED_Probing REPLACE=1
    
    # Safety check
    {% if printer.toolhead.homed_axes != "xyz" %}
        {action_respond_info("Homing all axes...")}
        G28
    {% endif %}
    
    # Heat bed and extruder for thermal expansion
    {action_respond_info("Heating bed to %dC..." % BED_TEMP)}
    M140 S{BED_TEMP}
    {action_respond_info("Heating extruder to %dC..." % EXTRUDER_TEMP)}
    M104 S{EXTRUDER_TEMP}
    
    # Wait for temperatures
    M190 S{BED_TEMP}
    M109 S{EXTRUDER_TEMP}
    
    # Wait for thermal stabilization
    {action_respond_info("Waiting 3 minutes for thermal stabilization...")}
    G4 P180000
    
    # Level the gantry
    {action_respond_info("Step 1/3: Leveling gantry with Z-Tilt...")}
    Z_TILT_ADJUST
    
    # Re-home Z after tilt
    {action_respond_info("Re-homing Z axis...")}
    G28 Z
    
    # Create new bed mesh
    {action_respond_info("Step 2/3: Creating 7x7 bed mesh (49 points)...")}
    BED_MESH_CALIBRATE
    
    # Show mesh stats
    {action_respond_info("Bed mesh complete! Check Mainsail for mesh visualization.")}
    
    # Move to center for Z offset check
    {action_respond_info("Step 3/3: Moving to center for Z offset verification...")}
    G1 X150 Y150 Z50 F3000
    
    # Instructions
    {action_respond_info("Calibration Complete! Next steps:")}
    {action_respond_info("1. If Z offset needs adjustment, run: CALIBRATE_PROBE_Z")}
    {action_respond_info("2. When satisfied, run: SAVE_CALIBRATION")}
    {action_respond_info("3. Test with a print!")}
    {action_respond_info("")}
    {action_respond_info("NOTE: Heaters left ON at calibration temps for Z offset adjustment")}
    {action_respond_info("Run TURN_OFF_HEATERS when done")}
    
    M117 Calibration Done - Review Results
    SET_LED_EFFECT EFFECT=LED_FinishPrint REPLACE=1

[gcode_macro CALIBRATE_PROBE_Z]
description: Calibrate Z probe offset with proper heating
gcode:
    {% set BED_TEMP = params.BED_TEMP|default(50)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(100)|float %}
    
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}
    
    # Ensure proper temperatures for accurate calibration
    {% if printer.heater_bed.temperature < (BED_TEMP - 5) %}
        {action_respond_info("Heating bed to %dC..." % BED_TEMP)}
        M190 S{BED_TEMP}
    {% endif %}
    
    {% if printer.extruder.temperature < (EXTRUDER_TEMP - 5) %}
        {action_respond_info("Heating extruder to %dC..." % EXTRUDER_TEMP)}
        M109 S{EXTRUDER_TEMP}
    {% endif %}
    
    {action_respond_info("Starting Z Probe Calibration at bed:%dC extruder:%dC" % (BED_TEMP, EXTRUDER_TEMP))}
    {action_respond_info("Use paper test: TESTZ Z=-0.01 to lower, Z=+0.01 to raise")}
    {action_respond_info("When correct, type ACCEPT then SAVE_CALIBRATION")}
    PROBE_CALIBRATE

[gcode_macro SAVE_CALIBRATION]
description: Save calibration results to config
gcode:
    {action_respond_info("Saving calibration data...")}
    SAVE_CONFIG
    {action_respond_info("Configuration saved! Printer will restart.")}

[gcode_macro QUICK_CALIBRATION]
description: Quick calibration - Z-tilt and bed mesh only (no heating/waiting)
gcode:
    M117 Quick Calibration
    {action_respond_info("Quick Calibration - assumes bed is already at temp")}
    SET_LED_EFFECT EFFECT=LED_Probing REPLACE=1
    
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}
    
    {action_respond_info("Leveling gantry...")}
    Z_TILT_ADJUST
    G28 Z
    
    {action_respond_info("Creating bed mesh...")}
    BED_MESH_CALIBRATE
    
    {action_respond_info("Quick calibration complete! Run SAVE_CALIBRATION when ready.")}
    M117 Quick Cal Done
    SET_LED_EFFECT EFFECT=LED_FinishPrint REPLACE=1

[gcode_macro CHECK_Z_TILT]
description: Check gantry level without adjustment
gcode:
    {% if printer.toolhead.homed_axes != "xyz" %}
        G28
    {% endif %}
    
    {action_respond_info("Checking Z-tilt status...")}
    Z_TILT_ADJUST
    {action_respond_info("Z-tilt check complete. See results above.")}

[gcode_macro VERIFY_MESH]
description: Display current bed mesh statistics
gcode:
    {% set mesh = printer.bed_mesh %}
    {% if mesh.profile_name %}
        {action_respond_info("Active mesh: %s" % mesh.profile_name)}
        {action_respond_info("Mesh min: %.4f mm" % mesh.mesh_min)}
        {action_respond_info("Mesh max: %.4f mm" % mesh.mesh_max)}
        {action_respond_info("Mesh range: %.4f mm" % (mesh.mesh_max - mesh.mesh_min))}
    {% else %}
        {action_respond_info("No mesh currently loaded")}
    {% endif %}

[gcode_macro MAINTENANCE_REMINDER]
description: Shows when calibration was last done
gcode:
