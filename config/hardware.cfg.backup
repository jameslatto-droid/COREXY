#####################################################################
# Hardware Configuration
# MCU, Board Pins, Steppers, and Drivers
#####################################################################

[mcu]
serial: /dev/serial/by-id/usb-Klipper_stm32f407xx_4E0032001750563641353820-if00

[mcu rpi]
serial: /tmp/klipper_host_mcu

[board_pins]
aliases:
    EXP1_1=PG4, EXP1_3=PD11, EXP1_5=PG2, EXP1_7=PG6, EXP1_9=<GND>,
    EXP1_2=PA8, EXP1_4=PD10, EXP1_6=PG3, EXP1_8=PG7, EXP1_10=<5V>,
    EXP2_1=PB14, EXP2_3=PG10, EXP2_5=PF11, EXP2_7=PF12,  EXP2_9=<GND>,
    EXP2_2=PB13, EXP2_4=PB12, EXP2_6=PB15, EXP2_8=<RST>, EXP2_10=PF13

#####################################################################
# X/Y Stepper Settings
#####################################################################

[stepper_x]
step_pin: PE9
dir_pin: !PF1
enable_pin: !PF2
endstop_pin: PE15
microsteps: 32
rotation_distance: 40
full_steps_per_rotation: 200
position_min: 0
position_endstop: 300
position_max: 300
homing_speed: 25
homing_retract_dist: 5
homing_positive_dir: true

[tmc2209 stepper_x]
uart_pin: PC13
run_current: 1.1
stealthchop_threshold: 0

[stepper_y]
step_pin: PE11
dir_pin: !PE8
enable_pin: !PD7
endstop_pin: PE10
microsteps: 32
rotation_distance: 40
full_steps_per_rotation: 200
position_min: 0
position_endstop: 300
position_max: 300
homing_speed: 25
homing_retract_dist: 5
homing_positive_dir: true

[tmc2209 stepper_y]
uart_pin: PE3
run_current: 1.1
stealthchop_threshold: 0

#####################################################################
# Z Stepper Settings
#####################################################################

[stepper_z]
step_pin: PE13
dir_pin: PE7
enable_pin: !PA3
microsteps: 32
rotation_distance: 4
full_steps_per_rotation: 200
gear_ratio: 3:1
position_endstop: 0
position_max: 400
homing_speed: 5
position_min: -2
endstop_pin: PG8

[tmc2209 stepper_z]
uart_pin: PD1
run_current: 1.1
stealthchop_threshold: 1000

[stepper_z1]
step_pin: PD15
dir_pin: PC2
enable_pin: !PC0
microsteps: 32
rotation_distance: 4
full_steps_per_rotation: 200
gear_ratio: 3:1
endstop_pin: PG5

[tmc2209 stepper_z1]
uart_pin: PE1
run_current: 1.1
stealthchop_threshold: 1000
